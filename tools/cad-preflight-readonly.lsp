; Read-only CAD preflight inspector for AutoCAD Core Console. No drawing or application setting writes.
(defun cp-fail (s) (princ (strcat "\nCAD_PREFLIGHT_ERROR: " s)) (exit))
(defun cp-need (v s) (if (not v) (cp-fail s)) v)
(defun cp-hex4 (n / s) (setq s "") (repeat 4 (setq s (strcat (substr "0123456789abcdef" (1+ (rem n 16)) 1) s) n (fix (/ n 16)))) s)
(defun cp-quote (s / out n) (if (not (eq (type s) 'STR)) (setq s "")) (setq out "\"") (foreach n (vl-string->list s) (setq out (strcat out (cond ((= n 34) "\\\"") ((= n 92) "\\\\") ((= n 8) "\\b") ((= n 12) "\\f") ((= n 10) "\\n") ((= n 13) "\\r") ((= n 9) "\\t") ((or (< n 32) (> n 126)) (if (> n 65535) (strcat "\\u" (cp-hex4 (+ 55296 (fix (/ (- n 65536) 1024)))) "\\u" (cp-hex4 (+ 56320 (rem (- n 65536) 1024)))) (strcat "\\u" (cp-hex4 n)))) (t (chr n)))))) (strcat out "\""))
(defun cp-num (n / s) (if (or (not (numberp n)) (>= (abs n) 1e100)) "null" (progn (setq s (rtos n 2 12)) (if (= (substr s 1 1) ".") (setq s (strcat "0" s))) (if (= (substr s 1 2) "-.") (setq s (strcat "-0" (substr s 2)))) (if (= (substr s (strlen s) 1) ".") (setq s (strcat s "0"))) s)))
(defun cp-pt (p) (if (and (listp p) (>= (length p) 2) (numberp (car p)) (numberp (cadr p)) (< (abs (car p)) 1e15) (< (abs (cadr p)) 1e15)) (strcat "[" (cp-num (car p)) "," (cp-num (cadr p)) "," (cp-num (if (and (>= (length p) 3) (numberp (caddr p)) (< (abs (caddr p)) 1e15)) (caddr p) 0.0)) "]") "null"))
(defun cp-dxf (code d) (cdr (assoc code d)))
(defun cp-inc (key alist / pair) (setq pair (assoc key alist)) (if pair (subst (cons key (1+ (cdr pair))) pair alist) (cons (cons key 1) alist)))
(defun cp-mtext (d / s item) (setq s "") (foreach item d (if (or (= (car item) 3) (= (car item) 1)) (setq s (strcat s (cdr item))))) s)
(defun cp-write-map (f alist / sep pair) (princ "{" f) (setq sep "") (foreach pair alist (princ (strcat sep (cp-quote (car pair)) ":" (itoa (cdr pair))) f) (setq sep ",")) (princ "}" f))
(defun cp-attribs (e / ae ad atype ac out sep tag val) (setq ae (entnext e) ac 0 out "[" sep "") (while (and ae (< ac 30)) (setq ad (entget ae) atype (if ad (cp-dxf 0 ad) nil)) (cond ((or (null ad) (= atype "SEQEND")) (setq ae nil)) ((= atype "ATTRIB") (setq tag (cp-dxf 2 ad) val (cp-dxf 1 ad) out (strcat out sep "{\"tag\":" (cp-quote tag) ",\"value\":" (cp-quote val) "}") sep "," ac (1+ ac) ae (entnext ae))) (t (setq ae (entnext ae))))) (strcat out "]"))
(defun cp-lwpoly-info (d / item vc hasBulge) (setq vc 0 hasBulge nil) (foreach item d (cond ((= (car item) 10) (setq vc (1+ vc))) ((and (= (car item) 42) (numberp (cdr item)) (> (abs (cdr item)) 1e-9)) (setq hasBulge T)))) (list vc hasBulge))
(defun cp-layouts (/ dict item out) (setq dict (dictsearch (namedobjdict) "ACAD_LAYOUT") out nil) (foreach item dict (if (and (= (car item) 3) (/= (strcase (cdr item)) "MODEL")) (setq out (cons (cdr item) out)))) (reverse out))
(defun cp-main (/ out before started f lay layCount laySep layouts layName ss ssn n e d typ h layer countsByType countsByLayer proxyCount lineCount polyCount circleCount arcCount textCount dimCount blockCount otherCount texts dims blocks textCap dimCap blockCap textTrunc dimTrunc blockTrunc psSs psN psIdx psE psD psTyp psCounts psTexts psTextCount psTextTrunc ssAfter extMin extMax item pinfo closedFlag elev meas dimTxt bname rot sx sy sz attJson)
  (cp-need (member (getvar "LISPSYS") '(1 2)) "unicode-engine-unavailable-no-setting-change")
  (cp-need (= (strcase (getvar "DWGNAME")) "SOURCE.DWG") "unexpected-dwg-name")
  (cp-need (= (strcase (getvar "DWGPREFIX")) (strcase (getenv "CAD_PREFLIGHT_INPUT_DIR"))) "unexpected-dwg-directory")
  (setq out (getenv "CAD_PREFLIGHT_OUTPUT") before (getvar "DBMOD") started (getvar "MILLISECS"))
  (cp-need (= before 0) "drawing-already-modified-on-open")
  (setq f (open out "w"))
  (cp-need f "cannot-open-json-output")
  (setq extMin (getvar "EXTMIN") extMax (getvar "EXTMAX"))
  (princ "{\"schemaVersion\":1,\"status\":\"cad-preflight-readonly\",\"readOnlyRequested\":true,\"saveRequested\":false," f)
  (princ (strcat "\"dbmodBefore\":" (itoa before) ",\"insunits\":" (itoa (getvar "INSUNITS")) ",\"lunits\":" (itoa (getvar "LUNITS")) ",\"measurement\":" (itoa (getvar "MEASUREMENT")) ",\"lispsys\":" (itoa (getvar "LISPSYS")) ",\"dwgCodePage\":" (cp-quote (getvar "DWGCODEPAGE")) ",\"insbase\":" (cp-pt (getvar "INSBASE")) ",\"extMin\":" (cp-pt extMin) ",\"extMax\":" (cp-pt extMax) ",") f)
  (princ "\"layouts\":[\"Model\"" f)
  (setq layouts (cp-layouts))
  (foreach layName layouts (princ (strcat "," (cp-quote layName)) f))
  (princ "],\"layers\":[" f)
  (setq lay (tblnext "LAYER" T) layCount 0 laySep "")
  (while (and lay (< layCount 500))
    (setq layName (cp-dxf 2 lay))
    (princ (strcat laySep "{\"name\":" (cp-quote layName) ",\"flags\":" (itoa (if (cp-dxf 70 lay) (cp-dxf 70 lay) 0)) ",\"color\":" (itoa (if (cp-dxf 62 lay) (cp-dxf 62 lay) 7)) ",\"frozen\":" (if (= (logand (if (cp-dxf 70 lay) (cp-dxf 70 lay) 0) 1) 1) "true" "false") ",\"locked\":" (if (= (logand (if (cp-dxf 70 lay) (cp-dxf 70 lay) 0) 4) 4) "true" "false") ",\"off\":" (if (< (if (cp-dxf 62 lay) (cp-dxf 62 lay) 7) 0) "true" "false") "}") f)
    (setq laySep "," layCount (1+ layCount) lay (tblnext "LAYER")))
  (princ (strcat "],\"layerCount\":" (itoa layCount) ",\"layersTruncated\":" (if lay "true" "false") ",") f)
  (setq ss (ssget "_X" '((410 . "Model"))) ssn (if ss (sslength ss) 0))
  (cp-need (<= ssn 50000) "excessive-Model-graphical-selection")
  (setq n 0 countsByType nil countsByLayer nil proxyCount 0 lineCount 0 polyCount 0 circleCount 0 arcCount 0 textCount 0 dimCount 0 blockCount 0 otherCount 0)
  (setq texts nil dims nil blocks nil textCap 2000 dimCap 1500 blockCap 1500 textTrunc nil dimTrunc nil blockTrunc nil)
  (while (< n ssn)
    (cp-need (< (- (getvar "MILLISECS") started) 60000) "internal-60-second-budget-exceeded")
    (setq e (ssname ss n) d (if e (entget e) nil))
    (cp-need d "unreadable-entity")
    (setq typ (cp-dxf 0 d) h (strcase (if (cp-dxf 5 d) (cp-dxf 5 d) "")) layer (if (cp-dxf 8 d) (cp-dxf 8 d) "0"))
    (setq countsByType (cp-inc typ countsByType) countsByLayer (cp-inc layer countsByLayer))
    (cond
      ((= typ "LINE") (setq lineCount (1+ lineCount)))
      ((or (= typ "LWPOLYLINE") (= typ "POLYLINE")) (setq polyCount (1+ polyCount)))
      ((= typ "CIRCLE") (setq circleCount (1+ circleCount)))
      ((= typ "ARC") (setq arcCount (1+ arcCount)))
      ((= typ "ACAD_PROXY_ENTITY") (setq proxyCount (1+ proxyCount)))
      ((or (= typ "TEXT") (= typ "MTEXT"))
       (setq textCount (1+ textCount))
       (if (< (length texts) textCap)
         (setq texts (cons (strcat "{\"handle\":" (cp-quote h) ",\"type\":" (cp-quote typ) ",\"layer\":" (cp-quote layer) ",\"text\":" (cp-quote (if (= typ "MTEXT") (cp-mtext d) (cp-dxf 1 d))) ",\"point\":" (cp-pt (cp-dxf 10 d)) ",\"height\":" (cp-num (cp-dxf 40 d)) "}") texts))
         (setq textTrunc T)))
      ((= typ "DIMENSION")
       (setq dimCount (1+ dimCount))
       (if (< (length dims) dimCap)
         (progn
           (setq dimTxt (if (cp-dxf 1 d) (cp-dxf 1 d) "") meas (cp-dxf 42 d))
           (setq dims (cons (strcat "{\"handle\":" (cp-quote h) ",\"layer\":" (cp-quote layer) ",\"textOverride\":" (cp-quote dimTxt) ",\"measurement\":" (cp-num meas) ",\"dimStyle\":" (cp-quote (cp-dxf 3 d)) ",\"dimType\":" (itoa (if (cp-dxf 70 d) (cp-dxf 70 d) 0)) "}") dims)))
         (setq dimTrunc T)))
      ((= typ "INSERT")
       (setq blockCount (1+ blockCount))
       (if (< (length blocks) blockCap)
         (progn
           (setq bname (cp-dxf 2 d) sx (cp-dxf 41 d) sy (cp-dxf 42 d) sz (cp-dxf 43 d) rot (cp-dxf 50 d))
           (setq attJson (if (= (cp-dxf 66 d) 1) (cp-attribs e) "[]"))
           (setq blocks (cons (strcat "{\"handle\":" (cp-quote h) ",\"layer\":" (cp-quote layer) ",\"blockName\":" (cp-quote bname) ",\"point\":" (cp-pt (cp-dxf 10 d)) ",\"scale\":[" (cp-num (if sx sx 1.0)) "," (cp-num (if sy sy 1.0)) "," (cp-num (if sz sz 1.0)) "],\"rotation\":" (cp-num (if rot rot 0.0)) ",\"attributes\":" attJson "}") blocks)))
         (setq blockTrunc T)))
      (t (setq otherCount (1+ otherCount))))
    (setq n (1+ n)))
  (setq ssAfter (ssget "_X" '((410 . "Model"))))
  (cp-need (= (if ssAfter (sslength ssAfter) 0) ssn) "selected-Model-count-changed")
  (setq psSs (ssget "_X" '((67 . 1))) psN (if psSs (sslength psSs) 0) psIdx 0 psCounts nil psTexts nil psTextCount 0 psTextTrunc nil)
  (while (and (< psIdx psN) (< psIdx 10000))
    (setq psE (ssname psSs psIdx) psD (if psE (entget psE) nil))
    (if psD (progn
      (setq psTyp (cp-dxf 0 psD))
      (setq psCounts (cp-inc psTyp psCounts))
      (if (or (= psTyp "TEXT") (= psTyp "MTEXT"))
        (progn
          (setq psTextCount (1+ psTextCount))
          (if (< (length psTexts) 500)
            (setq psTexts (cons (strcat "{\"type\":" (cp-quote psTyp) ",\"layer\":" (cp-quote (cp-dxf 8 psD)) ",\"layout\":" (cp-quote (cp-dxf 410 psD)) ",\"text\":" (cp-quote (if (= psTyp "MTEXT") (cp-mtext psD) (cp-dxf 1 psD))) "}") psTexts))
            (setq psTextTrunc T))))))
    (setq psIdx (1+ psIdx)))
  (cp-need (= before (getvar "DBMOD")) "drawing-modified-during-extraction")
  (princ (strcat "\"dbmodAfter\":" (itoa (getvar "DBMOD")) ",\"modelSpaceEntityCount\":" (itoa ssn) ",\"paperSpaceEntityCount\":" (itoa psN) ",\"proxyEntityCount\":" (itoa proxyCount) ",") f)
  (princ (strcat "\"geometrySummary\":{\"line\":" (itoa lineCount) ",\"polyline\":" (itoa polyCount) ",\"circle\":" (itoa circleCount) ",\"arc\":" (itoa arcCount) ",\"text\":" (itoa textCount) ",\"dimension\":" (itoa dimCount) ",\"insert\":" (itoa blockCount) ",\"proxy\":" (itoa proxyCount) ",\"other\":" (itoa otherCount) "},") f)
  (princ "\"countsByType\":" f) (cp-write-map f countsByType)
  (princ ",\"countsByLayer\":" f) (cp-write-map f countsByLayer)
  (princ ",\"paperSpaceCountsByType\":" f) (cp-write-map f psCounts)
  (princ (strcat ",\"textsTruncated\":" (if textTrunc "true" "false") ",\"texts\":[") f)
  (setq laySep "") (foreach item (reverse texts) (princ (strcat laySep item) f) (setq laySep ","))
  (princ (strcat "],\"dimensionsTruncated\":" (if dimTrunc "true" "false") ",\"dimensions\":[") f)
  (setq laySep "") (foreach item (reverse dims) (princ (strcat laySep item) f) (setq laySep ","))
  (princ (strcat "],\"blocksTruncated\":" (if blockTrunc "true" "false") ",\"blocks\":[") f)
  (setq laySep "") (foreach item (reverse blocks) (princ (strcat laySep item) f) (setq laySep ","))
  (princ (strcat "],\"paperSpaceTextsTruncated\":" (if psTextTrunc "true" "false") ",\"paperSpaceTexts\":[") f)
  (setq laySep "") (foreach item (reverse psTexts) (princ (strcat laySep item) f) (setq laySep ","))
  (princ "]}" f)
  (close f)
  (princ (strcat "\nCAD_PREFLIGHT_SUCCESS modelSpace=" (itoa ssn) " paperSpace=" (itoa psN) " texts=" (itoa textCount) " dims=" (itoa dimCount) " blocks=" (itoa blockCount) " proxies=" (itoa proxyCount))) T)
(setq cp-result (vl-catch-all-apply 'cp-main nil))
(if (vl-catch-all-error-p cp-result) (princ (strcat "\nCAD_PREFLIGHT_FAILED: " (vl-catch-all-error-message cp-result))))
(princ)
