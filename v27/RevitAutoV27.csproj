<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">$(REVIT_2027_INSTALL_DIR)</RevitInstallDir>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">$(ProgramW6432)\Autodesk\Revit 2027</RevitInstallDir>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RevitAutoV27</AssemblyName>
    <Version>0.4.0</Version>
    <RootNamespace>RevitAutoV27</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <OutputPath>bin\Release\net10.0-windows-v27-family-snapshot-0400\</OutputPath>
    <IntermediateOutputPath>obj\Release\net10.0-windows-v27\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
      <ExternallyResolved>true</ExternallyResolved>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
      <ExternallyResolved>true</ExternallyResolved>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateRevitApiDirectory" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(RevitInstallDir)\RevitAPI.dll') Or !Exists('$(RevitInstallDir)\RevitAPIUI.dll')"
           Text="Revit API DLLs are missing. Use build-v27.ps1 -RevitInstallDir or set REVIT_2027_INSTALL_DIR. Autodesk API DLLs are not distributed with this project." />
  </Target>
</Project>
